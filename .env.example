# Copy this file to .env for local development.
# Do not commit real passwords or secrets.

AIRFLOW_UID=50000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=energy_pipeline

# Optional: override the individual POSTGRES_* settings above.
# DATABASE_URL=postgresql://postgres:change_me@localhost:5432/energy_pipeline

# docker-compose now bundles a PostgreSQL service. Inside the Airflow
# container it is reachable as "postgres" (the compose default); from your
# host machine (run_pipeline.py, psql, Power BI, dbt) use localhost.
# If you instead run PostgreSQL yourself on the host, set
# POSTGRES_HOST=host.docker.internal so the Airflow container can reach it.

# Set to true to let the pipeline download the latest AER ST98 workbooks
# before each run instead of using the files committed under data/raw.
AER_AUTO_DOWNLOAD=false

# Override the workbook URLs when AER publishes a new ST98 edition.
# CRUDE_OIL_XLSX_URL=https://documents.aer.ca/sts/st98/2025/st98-2025-crude-oil-supplydemand-data.xlsx
# NATURAL_GAS_XLSX_URL=https://documents.aer.ca/sts/st98/2025/st98-2025-naturalgas-supplydemand-data.xlsx
